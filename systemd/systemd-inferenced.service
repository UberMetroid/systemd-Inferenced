[Unit]
Description=Heterogeneous AI Hardware Arbiter and Model Lifecycle Broker
Documentation=https://github.com/UberMetroid/systemd-Inferenced
After=network.target local-fs.target
Requires=systemd-inferenced.socket

[Service]
Type=notify
ExecStart=/usr/bin/systemd-inferenced
Restart=on-failure
RestartSec=3s
Slice=ai.slice

# Security & Sandboxing
User=inferenced
Group=inferenced
SupplementaryGroups=render video sentry
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Delegate=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Directories
RuntimeDirectory=systemd-inferenced
RuntimeDirectoryMode=0755
ConfigurationDirectory=systemd/inferenced.conf.d
StateDirectory=systemd-inferenced
LogsDirectory=systemd-inferenced

# Linux Device Permissions (DRM & Accel)
DeviceAllow=/dev/dri/renderD* rw
DeviceAllow=/dev/accel/* rw
DeviceAllow=/dev/hailo* rw
DeviceAllow=/dev/kfd rw

# cgroup v2 & OOM Protection
ManagedOOMPreference=avoid

[Install]
WantedBy=multi-user.target
Alias=inferenced.service
