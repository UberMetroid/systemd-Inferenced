[Unit]
Description=AI Inference and Hardware Workloads Root Slice
Documentation=https://github.com/UberMetroid/systemd-Inferenced
Before=slices.target

[Slice]
# Root slice for AI workloads and lifecycle broker
CPUWeight=100
IOWeight=100
MemoryHigh=80%
ManagedOOMPreference=avoid
ManagedOOMMemoryPressure=auto
ManagedOOMMemoryPressureLimit=85%
ManagedOOMSwap=auto
