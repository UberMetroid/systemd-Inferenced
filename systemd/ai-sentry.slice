[Unit]
Description=systemd-sentry Emergency Triage Enclave Slice
Documentation=https://github.com/UberMetroid/systemd-sentry
Before=slices.target

[Slice]
# Emergency supervisor priority: absolute precedence, protected memory
CPUWeight=1000
IOWeight=1000
MemoryMin=512M
MemoryLow=1G
ManagedOOMPreference=omit
